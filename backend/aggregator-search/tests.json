{
  "tests": [
    {
      "name": "Автопоиск по всем направлениям (GET)",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"ai_powered": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Поиск по одному направлению — горное",
      "method": "POST",
      "path": "/",
      "body": {"topic_id": "mining"},
      "expectedStatus": 200,
      "expectedBody": {"ai_powered": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестное направление — ошибка",
      "method": "POST",
      "path": "/",
      "body": {"topic_id": "unknown_xyz"},
      "expectedStatus": 400,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial",
      "expectedBody": {}
    }
  ]
}
