{
  "tests": [
    {
      "name": "Поиск возвращает поле query",
      "method": "POST",
      "path": "/",
      "body": {"query": "токарные работы"},
      "expectedStatus": 200,
      "expectedBody": {"query": "токарные работы"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Пустой запрос — ошибка",
      "method": "POST",
      "path": "/",
      "body": {"query": ""},
      "expectedStatus": 400,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial",
      "expectedBody": {}
    }
  ]
}